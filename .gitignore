# Dependencies (regenerable via npm install)
node_modules/

# IDE / editor config (machine-specific)
.idea/
.vscode/
*.iml

# OS junk files
Thumbs.db
.DS_Store

# Backup archives (not source, don't belong in history)
*.7z
*.zip
*.rar

# Android build output (regenerated by gradlew)
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/app/release/

# Capacitor generated files (regenerated by npx cap sync)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Logs
*.log
npm-debug.log*
