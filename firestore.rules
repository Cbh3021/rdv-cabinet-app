rules_version = '2';

// =============================================================================
// RÈGLES ACTIVES — version corrigée (boutons « Honoré » / « Non présenté »)
//
// Cause du blocage : l'ancienne règle `update` du médecin n'acceptait que 15
// noms de champs précis, et toute collection non listée (paiement, caisse…)
// était refusée par défaut. Dès que l'appli écrit UN champ de plus ou touche
// une autre collection, Firestore répond « permission-denied » et le bouton
// ne fait rien.
//
// Ici, le médecin (compte listé dans `admins`) a tous les droits ; les
// restrictions ne s'appliquent qu'aux patients, comme avant.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Patient authentifié par email synthétique "p<téléphone_e164>@rdvcabinet.local"
    function isOwner(phone) {
      return request.auth != null &&
        request.auth.token.email == "p" + phone + "@rdvcabinet.local";
    }

    // Blocage programmé (contacts/{phone}.blockedFrom). exists() d'abord :
    // get(...).data fait échouer la règle si la fiche n'existe pas.
    function isBlocked(phone) {
      return exists(/databases/$(database)/documents/contacts/$(phone)) &&
        get(/databases/$(database)/documents/contacts/$(phone)).data.get('blockedFrom', null) != null &&
        get(/databases/$(database)/documents/contacts/$(phone)).data.blockedFrom <= request.time;
    }

    // Création d'un RDV : on vérifie la forme des champs essentiels
    // (sans liste fermée de clés, pour ne pas bloquer un champ ajouté plus tard).
    function isValidAppointment() {
      return request.resource.data.name is string
             && request.resource.data.name.size() > 0
             && request.resource.data.name.size() < 200
             && request.resource.data.phone is string
             && request.resource.data.phone.matches('^\\+[0-9]{6,15}$')
             && request.resource.data.date is string
             && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && request.resource.data.time is string
             && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
             && request.resource.data.reason is string;
    }

    match /appointments/{apptId} {
      allow read: if isAdmin() || (isOwner(resource.data.phone) && resource.data.get('deleted', false) != true && !isBlocked(resource.data.phone));
      allow create: if isAdmin() && isValidAppointment();
      // Médecin : modification libre (Honoré, Non présenté, paiement, notes…).
      // Patient : uniquement poser/retirer `patientRequest` sur son propre RDV.
      allow update: if isAdmin() ||
        (isOwner(resource.data.phone) && resource.data.get('deleted', false) != true && !isBlocked(resource.data.phone) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientRequest']));
      allow delete: if isAdmin();
    }

    // Archive (RDV > 90 jours). Le script d'archivage passe par le SDK Admin
    // (il contourne les règles). Le médecin peut modifier un ancien RDV
    // (ex. marquer « Honoré » après coup) ; les patients restent en lecture seule.
    match /appointments_history/{apptId} {
      allow read: if isAdmin() || (isOwner(resource.data.phone) && resource.data.get('deleted', false) != true && !isBlocked(resource.data.phone));
      allow write: if isAdmin();
    }

    // Compteurs honoré / absent / total par patient
    match /patients/{phone} {
      allow read: if isAdmin() || isOwner(phone);
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'fcmUpdatedAt']);
      allow create, delete: if false;
    }

    match /contacts/{phone} {
      allow read: if isAdmin() || isOwner(phone);
      allow write: if isAdmin() ||
        (isOwner(phone) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken','lang']));
    }

    // Toute autre collection (paiements, caisse, réglages…) : réservée au médecin.
    // Sans cette règle, une écriture vers une collection non listée est refusée
    // et fait échouer en bloc le lot / la transaction qui l'accompagne.
    // (`admins` est exclue : on ne peut toujours pas créer d'admin depuis l'appli.)
    match /{col}/{doc=**} {
      allow read, write: if isAdmin() && col != 'admins';
    }
  }
}
